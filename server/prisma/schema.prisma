generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  appName        String?
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users               User[]
  contacts            Contact[]
  contactGroups       ContactGroup[]
  contactStatusEvents ContactStatusEvent[]
  telnyxConfigs       TelnyxConfig[]
  conversations       Conversation[]
  voiceCallTwimls     VoiceCallTwiml[]
  invites             Invite[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id])
  createdGroups   ContactGroup[]
  passwordResets  PasswordResetToken[]
  sentThreadMessages ThreadMessage[]   @relation("SentThreadMessages")
  threadMembershipsA Thread[]          @relation("ThreadMemberA")
  threadMembershipsB Thread[]          @relation("ThreadMemberB")

  @@index([organizationId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

model TelnyxConfig {
  id             String   @id @default(cuid())
  organizationId String
  apiKey         String
  phoneNumber    String
  messagingProfileId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([phoneNumber])
}

model Contact {
  id                 String   @id @default(cuid())
  organizationId     String
  firstName          String
  lastName           String
  fullName           String
  phoneNumber        String
  email              String?
  birthday           String?
  isActive           Boolean  @default(true)
  isOptedOut         Boolean  @default(false)
  isBlockedSuspected Boolean  @default(false)
  blockedReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id])
  groupMemberships ContactGroupMember[]
  statusEvents     ContactStatusEvent[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([phoneNumber])
}

model ContactGroup {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  createdBy    User                 @relation(fields: [createdByUserId], references: [id])
  members      ContactGroupMember[]

  @@index([organizationId])
}

model ContactGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
}

model ContactStatusEvent {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String
  eventType      String
  source         String
  detail         String?
  messageSid     String?
  errorCode      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([messageSid])
  @@index([createdAt])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  phoneNumber    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  body           String
  type           String   @default("sms")
  status         String?
  messageSid     String?  @unique
  fromNumber     String
  toNumber       String
  mediaUrl       String?
  errorCode      String?
  errorMessage   String?
  callDuration   Int?
  callStatus     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([messageSid])
  @@index([createdAt])
}

model VoiceCallTwiml {
  id             String   @id @default(cuid())
  organizationId String
  messageText    String
  voiceName      String   @default("alice")
  voiceLanguage  String   @default("en-US")
  used           Boolean  @default(false)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Thread {
  id        String   @id @default(cuid())
  memberAId String
  memberBId String
  createdAt DateTime @default(now())

  memberA  User            @relation("ThreadMemberA", fields: [memberAId], references: [id])
  memberB  User            @relation("ThreadMemberB", fields: [memberBId], references: [id])
  messages ThreadMessage[]

  @@unique([memberAId, memberBId])
  @@index([memberAId])
  @@index([memberBId])
}

model ThreadMessage {
  id           String   @id @default(cuid())
  threadId     String
  senderUserId String
  body         String
  messageSid   String?
  createdAt    DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation("SentThreadMessages", fields: [senderUserId], references: [id])

  @@index([threadId])
  @@index([createdAt])
}

model Invite {
  id             String   @id @default(cuid())
  organizationId String
  groupId        String
  token          String   @unique
  createdByUserId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([token])
  @@index([organizationId])
}
