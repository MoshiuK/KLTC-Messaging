generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  contacts            Contact[]
  contactGroups       ContactGroup[]
  contactStatusEvents ContactStatusEvent[]
  twilioConfigs       TwilioConfig[]
  conversations       Conversation[]
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id])
  createdGroups ContactGroup[]

  @@index([organizationId])
}

model TwilioConfig {
  id             String   @id @default(cuid())
  organizationId String
  accountSid     String
  authToken      String
  phoneNumber    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([phoneNumber])
}

model Contact {
  id                 String   @id @default(cuid())
  organizationId     String
  firstName          String
  lastName           String
  fullName           String
  phoneNumber        String
  email              String?
  isActive           Boolean  @default(true)
  isOptedOut         Boolean  @default(false)
  isBlockedSuspected Boolean  @default(false)
  blockedReason      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id])
  groupMemberships ContactGroupMember[]
  statusEvents     ContactStatusEvent[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([phoneNumber])
}

model ContactGroup {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id])
  createdBy    User                 @relation(fields: [createdByUserId], references: [id])
  members      ContactGroupMember[]

  @@index([organizationId])
}

model ContactGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  contactId String
  createdAt DateTime @default(now())

  group   ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([groupId])
  @@index([contactId])
}

model ContactStatusEvent {
  id             String   @id @default(cuid())
  organizationId String
  contactId      String
  eventType      String
  source         String
  detail         String?
  twilioSid      String?
  errorCode      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  contact      Contact      @relation(fields: [contactId], references: [id])

  @@index([organizationId])
  @@index([contactId])
  @@index([twilioSid])
  @@index([createdAt])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  phoneNumber    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  messages     Message[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  direction      String
  body           String
  status         String?
  twilioSid      String?  @unique
  fromNumber     String
  toNumber       String
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([twilioSid])
  @@index([createdAt])
}
