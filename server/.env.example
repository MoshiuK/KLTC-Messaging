# Port the Node server listens on. Behind the dashboard reverse proxy
# (dashboard.knoxmediagroupinc.org, config: text-kltconnect), traffic for
# text.kltconnect.com and www.text.kltconnect.com is routed to 127.0.0.1:5173.
PORT=5173

# Public base URL used to build Twilio webhook callbacks (voice, status).
BASE_URL=https://text.kltconnect.com

# Comma-separated allowed CORS origins.
CORS_ORIGINS=https://text.kltconnect.com,https://www.text.kltconnect.com

# Auth
JWT_SECRET=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Prisma
DATABASE_URL=
