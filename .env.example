# Generate a strong random string — e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret

# Twilio credentials (from console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Comma-separated allowed origins (leave blank to allow all)
# Example: https://text.kltconnect.com
CORS_ORIGINS=https://text.kltconnect.com
